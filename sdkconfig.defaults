# ESP32-C3 / 8 MB Flash / no PSRAM
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Native USB serial/JTAG (UART0 GPIO21 conflicts with backlight).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# 25 Hz game logic timer; display refresh remains capable of >25 Hz.
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# Chinese glyph subset (verified at runtime with graceful English fallback).
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK=y
# Fixed internal LVGL arena for ~50 static objects and six tiny sprites.
CONFIG_LV_MEM_SIZE_KILOBYTES=48
CONFIG_FREERTOS_HZ=1000

# Bluetooth disabled: arcade is offline; reclaim RAM/Flash and power.
CONFIG_BT_ENABLED=n
